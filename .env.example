# Porta do servidor Node.js
# No Render, use a variável de ambiente PORT; o Render injeta a porta automaticamente.
PORT=3000

# Endereço de escuta do servidor
# 0.0.0.0 é obrigatório no Render para que a porta fique acessível externamente.
HOST=0.0.0.0

# Client ID OAuth 2.0 do Google
# Crie um credencial do tipo "ID do cliente OAuth" em:
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# Ambiente: development | production
NODE_ENV=development

# String de conexão do banco de dados externo (PostgreSQL).
# Quando definida, o servidor usa PostgreSQL em vez de arquivos JSON locais.
# Isso permite que contas, sessões, histórico e amizades sobrevivam a deploys
# no Render (plano gratuito) sem precisar de Persistent Disk pago.
# Exemplo (Supabase/Neon/Render PostgreSQL):
# DATABASE_URL=postgres://usuario:senha@host:porta/banco?sslmode=require
# DATABASE_URL=

# Diretório do banco de dados (arquivos JSON).
# Usado apenas quando DATABASE_URL não estiver definido.
# Em desenvolvimento padrão: data/ dentro do projeto.
# No Render, defina este valor para o ponto de montagem do Persistent Disk
# (ex.: /var/data) para que contas, sessões, histórico e amizades
# sobrevivam aos deploys.
# DATA_DIR=/var/data
