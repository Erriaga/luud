# Porta do servidor Node.js
# No Render, use a variável de ambiente PORT; o Render injeta a porta automaticamente.
PORT=3000

# Endereço de escuta do servidor
# 0.0.0.0 é obrigatório no Render para que a porta fique acessível externamente.
HOST=0.0.0.0

# Client ID OAuth 2.0 do Google
# Crie um credencial do tipo "ID do cliente OAuth" em:
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# Ambiente: development | production
NODE_ENV=development

# String de conexão do banco de dados externo (PostgreSQL).
# Quando definida, o servidor usa PostgreSQL em vez de arquivos JSON locais.
# Isso permite que contas, sessões, histórico e amizades sobrevivam a deploys
# no Render (plano gratuito) sem precisar de Persistent Disk pago.
# Exemplo (Supabase/Neon/Render PostgreSQL):
# DATABASE_URL=postgres://usuario:senha@host:porta/banco?sslmode=require
# DATABASE_URL=

# Diretório do banco de dados (arquivos JSON).
# Usado apenas quando DATABASE_URL não estiver definido.
# Em desenvolvimento padrão: data/ dentro do projeto.
# No Render, defina este valor para o ponto de montagem do Persistent Disk
# (ex.: /var/data) para que contas, sessões, histórico e amizades
# sobrevivam aos deploys.
# DATA_DIR=/var/data

# ---------------------------------------------------------------
# CONTA PREMIUM (pagamento único via Pix, acesso vitalício)
# ---------------------------------------------------------------
# Nome do plano exibido na interface
PREMIUM_PLAN_NAME=Conta Premium

# Preço do pagamento único, em reais
PREMIUM_PRICE_BRL=19.90

# Desconto temporário do plano Premium.
# Enquanto o desconto estiver valendo, a interface mostra o preço original
# (PREMIUM_PRICE_BRL) riscado ao lado do preço promocional, que é o valor
# efetivamente cobrado. Ao終ar o prazo, o preço normal volta a valer.
# Preço promocional, em reais
PREMIUM_PROMO_PRICE_BRL=9.90

# Data final do desconto (ISO 8601, com fuso horário).
# Vazio = 31 de dezembro do ano atual, às 23:59:59 (UTC).
PREMIUM_PROMO_UNTIL=

# Texto exibido junto do preço promocional.
# A data final é acrescentada automaticamente ("... até 31/12/2026").
PREMIUM_PROMO_LABEL=Desconto temporário

# Gateway de pagamento: mercadopago | stub
# - mercadopago: cobrança real (requer PIX_API_TOKEN)
# - stub:         modo de teste, gera um BR Code sem cobrança real
#                 (nunca use em produção)
PIX_GATEWAY=stub

# Access token do Mercado Pago (Produção ou Teste)
# Gere em https://www.mercadopago.com.br/developers/pt-br/credentials
PIX_API_TOKEN=

# Segredo da assinatura do webhook do Mercado Pago (opcional,
# mas recomendado: evita que alguém libere o Premium sem pagar)
PIX_WEBHOOK_SECRET=

# Chave Pix que recebe o pagamento (usada no modo stub)
PIX_KEY=

# Nome e cidade que aparecem no QR Code do Pix
PIX_MERCHANT_NAME=LUUD
PIX_MERCHANT_CITY=SAO PAULO

# URL pública do servidor (usada no link do webhook).
# Exemplo: https://luud.com.br
PUBLIC_URL=

# Validade da cobrança Pix, em minutos
PAYMENT_EXPIRY_MINUTES=30
